# Managed by ansible/roles/buzz -- edits here are overwritten on the next run.
# Adapted from block/buzz deploy/compose/.env.example @ 0571f5455b1b2aeea7334082f0df9d1f19b22f7d.
# Secrets below are settled, not regenerated: back this file up, and never
# hand-rotate POSTGRES_PASSWORD / BUZZ_S3_* against surviving data volumes.

BUZZ_IMAGE={{ buzz_image }}

# Public host name. Used by compose.caddy.yml and the URL-derived settings.
BUZZ_DOMAIN={{ buzz_host }}
RELAY_URL=wss://{{ buzz_host }}
BUZZ_MEDIA_BASE_URL=https://{{ buzz_host }}/media
BUZZ_MEDIA_SERVER_DOMAIN={{ buzz_host }}
BUZZ_CORS_ORIGINS=https://{{ buzz_host }}

# NIP-AB device pairing. Advertised as `pairing_relay_url` in the relay's
# NIP-11 document, which is how clients find the buzz-pair-relay sidecar;
# Caddy routes this exact path to it. Same domain on purpose -- no extra DNS
# record, unlike upstream's helm chart (pairingRelay.url).
BUZZ_PAIRING_RELAY_URL=wss://{{ buzz_host }}/pair

# Production defaults: closed relay, auth required, migrations on boot.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. Deliberately NOT prefixed with BUZZ_ (upstream reads this
# exact name). The owner's own long-lived pubkey, passed in from outside.
RELAY_OWNER_PUBKEY={{ buzz_owner_pubkey }}

# Stable secrets -- generated once on first run, reused forever after.
BUZZ_RELAY_PRIVATE_KEY={{ _buzz_secrets['BUZZ_RELAY_PRIVATE_KEY'] }}
BUZZ_GIT_HOOK_HMAC_SECRET={{ _buzz_secrets['BUZZ_GIT_HOOK_HMAC_SECRET'] }}
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD={{ _buzz_secrets['POSTGRES_PASSWORD'] }}
REDIS_PASSWORD={{ _buzz_secrets['REDIS_PASSWORD'] }}
BUZZ_S3_ACCESS_KEY={{ _buzz_secrets['BUZZ_S3_ACCESS_KEY'] }}
BUZZ_S3_SECRET_KEY={{ _buzz_secrets['BUZZ_S3_SECRET_KEY'] }}
BUZZ_S3_BUCKET=buzz-media
# Bundled MinIO is path-style only: Docker DNS resolves `minio`, not
# `<bucket>.minio`. compose.yml pins this too; do not point it at an external
# S3 provider through here.
BUZZ_S3_ADDRESSING_STYLE=path

# Relay port. compose.caddy.yml publishes it on 127.0.0.1 only.
BUZZ_HTTP_PORT={{ buzz_http_port }}

# Caddy (TLS overlay).
ACME_EMAIL={{ acme_email }}
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
