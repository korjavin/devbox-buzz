# Managed by ansible/roles/stash -- edits here are overwritten on the next run,
# except STASH_SECRETS_KEY, which is read back and reused so a re-run never
# rotates it.
#
# BACK THIS FILE UP. STASH_SECRETS_KEY encrypts every secret in the stash_data
# volume; losing it loses all of them, with no recovery.
STASH_SECRETS_KEY={{ _stash_secrets_key }}
STASH_PORT={{ stash_port }}
