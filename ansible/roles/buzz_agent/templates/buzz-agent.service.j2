[Unit]
Description=buzz-acp harness (Claude Code agent on the local buzz relay)
Documentation=https://github.com/block/buzz/tree/main/crates/buzz-acp
# The relay runs in Docker on this host and is reached over loopback.
After=network-online.target docker.service
Wants=network-online.target

[Service]
User={{ devbox_user }}
Group={{ devbox_user }}
WorkingDirectory={{ buzz_agent_workspace }}
EnvironmentFile={{ buzz_agent_config_dir }}/env
# ~/.local/bin holds buzz-acp, the buzz CLI the agent replies with, and the
# npm globals (claude-agent-acp, claude). systemd gives services a minimal PATH.
Environment=PATH={{ devbox_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart={{ devbox_user_home }}/.local/bin/buzz-acp
# The relay may still be starting, or Claude may be rate-limited: keep retrying.
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
