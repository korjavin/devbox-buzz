# Managed by ansible (roles/buzz_agent) — do not edit on the box.
# 0600: holds this agent's Nostr secret key and its model credential.
BUZZ_PRIVATE_KEY={{ buzz_agent_privkey }}
BUZZ_RELAY_URL={{ buzz_relay_url }}
# Same key, second consumer: git-credential-nostr signs the agent's git
# clone/push against the relay's smart-HTTP endpoint with it (hex is fine —
# the helper's Keys::parse takes hex and nsec1 alike).
NOSTR_PRIVATE_KEY={{ buzz_agent_privkey }}

# The ACP adapter buzz-acp spawns (an npm global installed by this role).
# BUZZ_ACP_AGENT_ARGS is left unset on purpose: its default ("acp") is a
# goose-ism that buzz-acp normalizes to zero args for the known adapters
# (buzz-acp config.rs::normalize_agent_args).
BUZZ_ACP_AGENT_COMMAND={{ agent.adapter_command }}

# No ANTHROPIC_API_KEY in this deployment. The Agent SDK lists
# CLAUDE_CODE_OAUTH_TOKEN among its credential env vars and only falls back to
# ~/.claude/.credentials.json when neither it nor ANTHROPIC_API_KEY is set.
# codex-acp has no env credential at all — it reads ~/.codex/auth.json.
CLAUDE_CODE_OAUTH_TOKEN={{ claude_code_oauth_token }}

# Inbound author gate.
BUZZ_ACP_RESPOND_TO={{ buzz_agent_respond_to }}
{% if buzz_relay_owner_pubkey %}
BUZZ_ACP_AGENT_OWNER={{ buzz_relay_owner_pubkey }}
{% endif %}
{% if buzz_agent_respond_to_allowlist %}
BUZZ_ACP_RESPOND_TO_ALLOWLIST={{ buzz_agent_respond_to_allowlist }}
{% endif %}
